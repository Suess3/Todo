rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/todos/{todoId} {
      allow read, write: if request.auth.uid == uid;
    }
    match /users/{uid}/productivity/{dayId} {
      allow read, write: if request.auth.uid == uid;
    }
    match /users/{uid}/pushSubscription/{docId} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
